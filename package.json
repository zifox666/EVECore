{
  "name": "@newdoublex/evecore",
  "version": "0.1.0",
  "type": "module",
  "description": "EVE Online Neocom-style Vue 3 component library: near-black windows, translucent white text, one touch of Cryo Blue.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zifox666/EVECore.git"
  },
  "homepage": "https://zifox666.github.io/EVECore/",
  "bugs": {
    "url": "https://github.com/zifox666/EVECore/issues"
  },
  "scripts": {
    "dev": "vite --port 4173",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json && node scripts/fix-dts.mjs",
    "prepublishOnly": "pnpm build:lib"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.45",
    "@iconify/utils": "^3.1.7",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.4",
    "shiki": "^3.23.0",
    "typescript": "~5.7.3",
    "unocss": "^66.12.0",
    "vite": "^6.4.6",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "pnpm@10.13.1",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "eve-online",
    "dark",
    "unocss"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./unocss": {
      "types": "./dist-lib/types/unocss.d.ts",
      "import": "./dist-lib/unocss.js"
    },
    "./style.css": "./dist-lib/evecore.css",
    "./tokens.css": "./dist-lib/tokens.css",
    "./icons/*": "./dist-lib/icons/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "design.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@iconify/utils": ">=2",
    "unocss": ">=0.60",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "unocss": {
      "optional": true
    },
    "@iconify/utils": {
      "optional": true
    }
  }
}
